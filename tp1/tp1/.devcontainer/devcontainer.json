{
  "name": "sd-dev",
  "image": "docker.io/twint/sd:latest",
  "features": {},
  "runArgs": [
    "--net=host",
    "--ipc=host"
  ],
  "containerEnv": {
    "WINIT_UNIX_BACKEND": "x11",
    "WAYLAND_DISPLAY": ""
  },
  "remoteEnv": {
    "WINIT_UNIX_BACKEND": "x11",
    "WAYLAND_DISPLAY": ""
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "twint.hdl-studio",
        "surfer-project.surfer",
        "Hudson-River-Trading.vscode-slang",
        "lramseyer.vaporview",
        "kukdh1.verible-formatter"
      ]
    }
  }
}